# SQLite is used automatically when DATABASE_URL is unset.
# For Neon, paste your connection string here (keep sslmode=require).
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require
HOST=127.0.0.1
PORT=8000

# Clerk Publishable Key (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is also accepted).
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
# Optional for future server-side Clerk user-management calls. Never sent to browsers.
# CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000,http://localhost:8000
# Add the deployed app's origin to CLERK_AUTHORIZED_PARTIES when hosting.
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@DIRECT-HOST.neon.tech/neondb?sslmode=require
